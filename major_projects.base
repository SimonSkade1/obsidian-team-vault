filters:
  and:
    - file.inFolder("projects-tasks-notes")
    - file.ext == "md"
    - file.name.startsWith(",")
    - parent.isEmpty()
    - '!file.name.contains(".sync-conflict-")'
    - '!file.path.contains("/handoffs/")'
    - or:
        - owner == formula.me
        - owner != formula.me
formulas:
  me: if(file("_local/me.md"), file("_local/me.md").properties.user.toString().lower(), "")
  own: if(owner, owner.toString().lower(), "")
  deferred: if(not_before, date(not_before) > now(), false)
  terminal: status == "done" || status == "cancelled" || status == "failed"
  effective_priority: if(priority.isEmpty(), 5, priority)
  section: 'if(formula.me == "", "0 ⚠ create _local/me.md with user: <your name>", if(formula.deferred, "4 Later", if(formula.own == formula.me, "1 Mine", if(formula.own == "", "3 Unassigned", "2 " + formula.own))))'
properties:
  formula.section:
    displayName: Section
  next_action_by:
    displayName: Next Action By
  not_before:
    displayName: Not Before
views:
  - type: table
    name: Active
    filters:
      and:
        - "!formula.terminal"
        - '!file.path.contains("/archived/")'
    groupBy:
      property: formula.section
      direction: ASC
    order:
      - file.name
      - formula.section
      - status
      - priority
      - parent
      - owner
      - next_action_by
      - not_before
      - subscribers
    sort:
      - property: formula.effective_priority
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 340
      formula.section: 130
      status: 100
      priority: 70
      parent: 70
      owner: 100
      next_action_by: 120
      not_before: 110
  - type: table
    name: Archived
    filters:
      and:
        - formula.terminal
    order:
      - file.name
      - status
      - owner
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 200
    columnSize:
      file.name: 340
      status: 100
      owner: 100
newItemFolder: projects-tasks-notes
