{
  "_comment": "Scheduled-run permissions for /vault-cleanup. Same base set as scheduled-settings.json plus mv (the routine's core operation) and rmdir (pruning folders it emptied). Kept separate so the review/task-runner jobs don't inherit file-moving rights.",
  "model": "opus",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "TodoWrite",
      "Task",
      "Bash(git:*)",
      "Bash(python3:*)",
      "Bash(mv:*)",
      "Bash(rmdir:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(test:*)",
      "Bash([:*)"
    ],
    "deny": [
      "WebSearch",
      "WebFetch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(nc:*)",
      "Bash(sudo:*)",
      "Bash(rm:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Calendar",
      "mcp__claude_ai_Google_Drive"
    ]
  }
}
