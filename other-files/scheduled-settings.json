{
  "model": "opus",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "TodoWrite",
      "Task",
      "Bash(git:*)",
      "Bash(python3:*)",
      "Bash(.claude/scripts/*)",
      "Bash(./.claude/scripts/*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(cut:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(test:*)",
      "Bash([:*)"
    ],
    "deny": [
      "WebSearch",
      "WebFetch",
      "Read(~/.claude/**)",
      "Read(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(nc:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf /*)",
      "Bash(git push:*)",
      "mcp__claude_ai_Gmail",
      "mcp__claude_ai_Google_Calendar",
      "mcp__claude_ai_Google_Drive"
    ]
  }
}
