# Health check of the Discord bot session, every 5 minutes (pai-discord-watchdog.timer):
# other-files/discord/watchdog.py says what it checks, what it restarts and whom it tells.
# Same host assumptions as pai-discord-bot.service (vault at ~/obsidian-team-vault) and the
# same claude.env: its probe starts a fresh `claude -p` with the bot's credentials.
# Logs: journalctl --user -u pai-discord-watchdog -o cat   (silent while everything is fine)
[Unit]
Description=Team vault — Discord bot watchdog (checks the session, restarts it, DMs simon)
After=pai-discord-bot.service

[Service]
Type=oneshot
WorkingDirectory=%h/obsidian-team-vault
EnvironmentFile=-%h/.claude/channels/discord/claude.env
ExecStart=/usr/bin/python3 %h/obsidian-team-vault/other-files/discord/watchdog.py
TimeoutStartSec=5min
Nice=10
