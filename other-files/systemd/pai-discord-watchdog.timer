# Runs pai-discord-watchdog.service every 5 minutes (see that unit). Linked and enabled by install.sh.
[Unit]
Description=Team vault — Discord bot watchdog, every 5 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=pai-discord-watchdog.service

[Install]
WantedBy=timers.target
