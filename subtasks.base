filters:
  and:
    - or:
        - parent == this
        - formula.anc2.asLink() == this
        - formula.anc3.asLink() == this
        - formula.anc4.asLink() == this
    - '!file.name.contains(".sync-conflict-")'
    - or:
        - owner == if(formula.me, link(formula.me), "")
        - owner != if(formula.me, link(formula.me), "")
    - or:
        - reviewer == this.owner
        - reviewer != this.owner
formulas:
  user: if(file("_local/me.md"), file("_local/me.md").properties.user.toString().lower(), "")
  me: formula.user
  own: if(owner, owner.toString().replace(/^\[\[([^\]|]*\/)?|(\.md)?(\|[^\]]*)?\]\]$/g, "").lower(), "")
  rev: if(reviewer, reviewer.toString().replace(/^\[\[([^\]|]*\/)?|(\.md)?(\|[^\]]*)?\]\]$/g, "").lower(), formula.own)
  type: if(["note", "note-archived"].contains(status), "note", if(file.name.startsWith(",") || formula.kids.length > 0, "project", "task"))
  deferred: if(not_before, date(not_before) > now(), false)
  blocked: if(dependencies, list(dependencies).filter(value.asFile() && !["done", "cancelled", "failed", "note-archived", "review"].contains(value.asFile().properties.status)).length > 0, false)
  terminal: status == "done" || status == "cancelled" || status == "failed" || status == "note-archived"
  unassigned: formula.own == ""
  subscribed: list(subscribers).map(value.toString().replace(/^\[\[([^\]|]*\/)?|(\.md)?(\|[^\]]*)?\]\]$/g, "").lower()).contains(formula.me)
  parent_own: if(parent && parent.asFile(), if(parent.asFile().properties.owner, parent.asFile().properties.owner.toString().replace(/^\[\[([^\]|]*\/)?|(\.md)?(\|[^\]]*)?\]\]$/g, "").lower(), ""), "")
  delegated: formula.rev == formula.me && formula.own != formula.me
  mine: formula.me == "" || formula.own == formula.me || formula.rev == formula.me || formula.subscribed
  effective_priority: if(priority.isEmpty(), 5, priority) + if(due, if(date(due) < today(), 2, if(date(due) < today() + "1 day", 1, 0)), 0)
  archived_subscribed: formula.terminal && formula.subscribed && formula.own != formula.me && formula.rev != formula.me
  section: 'if(formula.me == "", "0 ⚠ create _local/me.md with user: <your name>", if(formula.terminal, if(formula.archived_subscribed, "15 Archived Subscribed", if(formula.type == "note", "14 Archived Notes", "13 Archived")), if(formula.blocked, "10 Blocked", if(formula.deferred, if(formula.type == "note", "12 Later Notes", "11 Later Tasks"), if(formula.important && formula.mine && priority >= 9, "0 Critical", if(formula.own == formula.me && status == "inbox", "1 Inbox", if(formula.own == formula.me && status == "in-progress", "2 In Progress", if(formula.rev == formula.me && status == "review", "3 Review", if(status == "discuss", "4 Discuss", if(formula.own == formula.me && status == "review", "7 Awaiting Review", if(formula.type == "note", "9 Notes", if(formula.own == formula.me, "5 Your Tasks", if(formula.rev == formula.me, "6 Delegated", if(formula.subscribed, "8 Subscribed", "16 Others"))))))))))))))'
  parent_terminal: if(parent && parent.asFile(), ["done", "cancelled", "failed", "note-archived"].contains(parent.asFile().properties.status), false)
  parented_note: formula.type == "note" && if(parent && parent.asFile(), true, false)
  nested: ((formula.own == formula.me && formula.parent_own == formula.me) || formula.parented_note) && !formula.parent_terminal
  nested_any: ((formula.own != "" && formula.own == formula.parent_own) || formula.parented_note) && !formula.parent_terminal
  live: '!formula.blocked && !formula.deferred && ["inbox", "in-progress", "review", "discuss"].contains(status)'
  important: '!formula.terminal && formula.type != "note" && formula.effective_priority >= 7'
  anc1: if(parent, parent.asFile())
  anc2: if(formula.anc1 && formula.anc1.properties.parent, formula.anc1.properties.parent.asFile())
  anc3: if(formula.anc2 && formula.anc2.properties.parent, formula.anc2.properties.parent.asFile())
  anc4: if(formula.anc3 && formula.anc3.properties.parent, formula.anc3.properties.parent.asFile())
  in_tree: (formula.anc1 && formula.anc1.asLink() == this) || (formula.anc2 && formula.anc2.asLink() == this) || (formula.anc3 && formula.anc3.asLink() == this) || (formula.anc4 && formula.anc4.asLink() == this)
  kids: file.backlinks.filter(value.asFile() && value.asFile().properties.parent && value.asFile().properties.parent.asFile() == file)
  has_children: formula.kids.filter(!["done", "cancelled", "failed", "note-archived", "review"].contains(value.asFile().properties.status)).length > 0
  is_head: formula.type == "project" && if(formula.in_tree && !formula.terminal, formula.kids.length > 0, formula.has_children)
  seg_self: if(priority, priority, 5).toString() + " " + file.basename.replace(/^,/, "")
  ancs: if(formula.anc1.asLink() == this, [], if(formula.anc2.asLink() == this, [formula.anc1], if(formula.anc3.asLink() == this, [formula.anc2, formula.anc1], if(formula.anc4.asLink() == this, [formula.anc3, formula.anc2, formula.anc1], [formula.anc4, formula.anc3, formula.anc2, formula.anc1]))))
  anc_path: formula.ancs.filter(value).map(if(value.properties.priority, value.properties.priority, 5).toString() + " " + value.basename.replace(/^,/, "")).join(" › ")
  pgroup: if(formula.is_head, if(formula.anc_path != "", formula.anc_path + " › ", "") + formula.seg_self, if(formula.anc_path != "", formula.anc_path, if(formula.anc1.asLink() == this, formula.anc1.basename.replace(/^,/, ""), "no project"))) + ":"
  sec_group: if((formula.live || formula.important) && formula.ancs.filter(value).length > 0, formula.section + " › " + formula.ancs.filter(value).map(value.basename.replace(/^,/, "")).join(" › "), formula.section)
  later_date: if(formula.section.contains("Later"), date(not_before).format("YYYY-MM-DD"), "")
properties:
  formula.section:
    displayName: Section
  formula.pgroup:
    displayName: Project
  formula.sec_group:
    displayName: Section › project
  reviewer:
    displayName: Reviewer
  not_before:
    displayName: Not Before
views:
  - type: table
    name: my project overview
    filters:
      and:
        - formula.mine
        - or:
            - parent == this
            - '["1 Inbox", "2 In Progress", "3 Review", "4 Discuss"].contains(formula.section)'
            - formula.important
    groupBy:
      property: formula.sec_group
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - owner
      - reviewer
      - subscribers
      - not_before
      - dependencies
      - due
    sort:
      - property: formula.later_date
        direction: ASC
      - property: formula.effective_priority
        direction: DESC
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 648
      note.reviewer: 87
      note.subscribers: 70
  - type: table
    name: my project subprojects
    filters:
      and:
        - formula.mine
        - "!(formula.terminal && formula.parent_terminal)"
    groupBy:
      property: formula.pgroup
      direction: DESC
    order:
      - file.name
      - formula.section
      - status
      - priority
      - owner
      - reviewer
      - subscribers
      - not_before
      - dependencies
      - due
    sort:
      - property: formula.is_head
        direction: DESC
      - property: formula.section
        direction: ASC
      - property: formula.later_date
        direction: ASC
      - property: formula.effective_priority
        direction: DESC
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 424
      formula.section: 130
      note.reviewer: 87
      note.subscribers: 70
  - type: kanban
    name: my board
    filters:
      and:
        - parent == this
        - formula.mine
        - "!formula.blocked"
        - "!formula.deferred"
        - formula.type != "note"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - inbox
      - 
      - in-progress
      - review
      - discuss
      - done
      - cancelled
    order:
      - file.name
      - priority
      - due
    sort:
      - property: formula.effective_priority
        direction: DESC
      - property: file.mtime
        direction: DESC
  - type: table
    name: everyone project overview
    filters:
      and:
        - or:
            - parent == this
            - formula.live
            - formula.important
    groupBy:
      property: formula.sec_group
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - owner
      - reviewer
      - subscribers
      - not_before
      - dependencies
      - due
    sort:
      - property: formula.later_date
        direction: ASC
      - property: formula.effective_priority
        direction: DESC
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 340
      note.reviewer: 87
      note.subscribers: 70
  - type: table
    name: everyone project subprojects
    filters:
      and:
        - "!(formula.terminal && formula.parent_terminal)"
    groupBy:
      property: formula.pgroup
      direction: DESC
    order:
      - file.name
      - formula.section
      - status
      - priority
      - owner
      - reviewer
      - subscribers
      - not_before
      - dependencies
      - due
    sort:
      - property: formula.is_head
        direction: DESC
      - property: formula.section
        direction: ASC
      - property: formula.later_date
        direction: ASC
      - property: formula.effective_priority
        direction: DESC
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 340
      formula.section: 130
      note.reviewer: 87
      note.subscribers: 70
  - type: kanban
    name: everyone board
    filters:
      and:
        - parent == this
        - "!formula.blocked"
        - "!formula.deferred"
        - formula.type != "note"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - inbox
      - 
      - in-progress
      - review
      - discuss
      - done
      - cancelled
    order:
      - file.name
      - owner
      - priority
      - due
    sort:
      - property: formula.effective_priority
        direction: DESC
      - property: file.mtime
        direction: DESC
