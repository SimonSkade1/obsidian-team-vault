filters:
  and:
    - parent == this
    - '!file.name.contains(".sync-conflict-")'
    - or:
        - owner == formula.me
        - owner != formula.me
formulas:
  me: if(file("_local/me.md"), file("_local/me.md").properties.user.toString().lower(), "")
  nab: if(next_action_by, next_action_by.toString().lower(), "")
  own: if(owner, owner.toString().lower(), "")
  type: if(file.name.startsWith(","), "project", if(file.name.startsWith("!"), "task", "note"))
  deferred: if(not_before, date(not_before) > now(), false)
  terminal: status == "done" || status == "cancelled" || status == "failed"
  my_turn: formula.nab == formula.me || (formula.nab == "" && formula.own == formula.me)
  bot: formula.nab == "claude" || (formula.nab == "" && formula.own == "claude")
  unassigned: formula.nab == "" && formula.own == ""
  subscribed: list(subscribers).map(value.toString().lower()).contains(formula.me)
  parent_own: if(parent && parent.asFile(), if(parent.asFile().properties.owner, parent.asFile().properties.owner.toString().lower(), ""), "")
  delegated: formula.own != formula.me && formula.parent_own == formula.me
  mine: formula.me == "" || formula.own == formula.me || formula.nab == formula.me || formula.subscribed || formula.delegated
  anc1: if(parent, parent.asFile())
  anc2: if(formula.anc1 && formula.anc1.properties.parent, formula.anc1.properties.parent.asFile())
  anc3: if(formula.anc2 && formula.anc2.properties.parent, formula.anc2.properties.parent.asFile())
  top: if(formula.anc3, formula.anc3, if(formula.anc2, formula.anc2, if(formula.anc1, formula.anc1, file)))
  lvl1: 'formula.top.backlinks.map(value.asFile()).filter(value.properties.parent.asFile() == formula.top && !["done", "cancelled", "failed"].contains(value.properties.status))'
  lvl2: 'formula.lvl1.map(value.backlinks).flat().map(value.asFile()).filter(formula.lvl1.contains(value.properties.parent.asFile()) && !["done", "cancelled", "failed"].contains(value.properties.status)).unique()'
  lvl3: 'formula.lvl2.map(value.backlinks).flat().map(value.asFile()).filter(formula.lvl2.contains(value.properties.parent.asFile()) && !["done", "cancelled", "failed"].contains(value.properties.status)).unique()'
  tree: '[formula.lvl1, formula.lvl2, formula.lvl3].flat().filter(value.properties.priority && (value.properties.owner.toString().lower() == formula.me || value.properties.next_action_by.toString().lower() == formula.me) && (["inbox", "in-progress", "review", "on-hold"].contains(value.properties.status) || ((!value.properties.next_action_by || value.properties.next_action_by.toString().lower() == formula.me) && !(value.properties.not_before && date(value.properties.not_before) > now()) && (value.name.startsWith(",") || value.name.startsWith("!"))))).map(value.properties.priority.toString() + "|" + [value.properties.parent.asFile(), value.properties.parent.asFile().properties.parent.asFile(), value.properties.parent.asFile().properties.parent.asFile().properties.parent.asFile()].filter(value).map(value.path).join("|") + "|")'
  effective_priority: 'max(if(priority.isEmpty(), 5, priority), formula.tree.filter(value.contains("|" + file.path + "|")).map(number(value.replace(/\|.*/, ""))).reduce(max(acc, value), 0))'
  responsible: formula.own == formula.me || formula.nab == formula.me
  section: 'if(formula.me == "", "0 ⚠ create _local/me.md with user: <your name>", if(formula.terminal, if(formula.type == "note", "13 Archived Notes", "12 Archived"), if(formula.responsible && status == "in-progress", "2 In Progress", if(formula.responsible && status == "inbox", "1 Inbox", if(formula.responsible && (status == "review" || status == "on-hold"), "3 Review", if(formula.type == "note", if(formula.deferred, "11 Later Notes", "9 Notes"), if(formula.deferred, "10 Later Tasks", if(formula.my_turn, "4 Your Tasks", if(formula.bot, "5 Claude", if(formula.delegated, "7 Delegated", if(formula.subscribed && formula.own != formula.me, "8 Subscribed", "6 Wait")))))))))))'
properties:
  formula.section:
    displayName: Section
  next_action_by:
    displayName: Next Action By
  not_before:
    displayName: Not Before
views:
  - type: table
    name: Mine
    filters:
      and:
        - formula.mine
    groupBy:
      property: formula.section
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - next_action_by
      - not_before
      - owner
      - subscribers
      - order
      - model
      - effort
    sort:
      - property: formula.effective_priority
        direction: DESC
      - property: order
        direction: ASC
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 340
      status: 100
      priority: 70
      next_action_by: 120
      not_before: 110
      owner: 100
      order: 70
      model: 90
      effort: 80
  - type: table
    name: All
    groupBy:
      property: formula.section
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - next_action_by
      - not_before
      - owner
      - subscribers
      - order
      - model
      - effort
    sort:
      - property: formula.effective_priority
        direction: DESC
      - property: order
        direction: ASC
      - property: file.ctime
        direction: DESC
    columnSize:
      file.name: 340
      status: 100
      priority: 70
      next_action_by: 120
      not_before: 110
      owner: 100
      order: 70
      model: 90
      effort: 80
